# Token para npm run publish (transição → GitHub Releases). NÃO commitar.
GH_TOKEN=

# Feed embutido em app-update.yml (provider generic). Padrão: config/default-feed.json
UPDATE_SERVER_URL=https://app-suite-update.dualbase.com.br/suite-device-app/stable

# Telemetria (API suite-update). Defaults em config/default-telemetry.json.
# Override na hora do build — valores são embutidos pelo electron-vite.
TELEMETRY_ENABLED=true
TELEMETRY_URL=http://127.0.0.1:8080/v1/telemetry/events
TELEMETRY_TOKEN=suite-update-telemetry-local
TELEMETRY_APPLICATION=suite-device-app
